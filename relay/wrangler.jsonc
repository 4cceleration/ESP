{
  // Relevo público del ESP32: la placa se conecta aquí por WebSocket y las visitas le llegan por esa conexión.
  "name": "esp",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "BOARD", "class_name": "Board" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Board"] }]
}
